# ===================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control
# ===================================================================

# Database Configuration
DB_USER=erp_user
DB_PASSWORD=CHANGE_TO_SECURE_PASSWORD
DB_NAME=erp_db

# Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=CHANGE_TO_SECURE_RANDOM_STRING_MIN_32_CHARS
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_TO_SECURE_PASSWORD_MIN_16_CHARS

# CORS Configuration (JSON array format)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Frontend Configuration
FRONTEND_PORT=80
API_URL=https://api.yourdomain.com

# ===================================================================
# GENERATE SECURE VALUES:
# ===================================================================
# Run: python backend/scripts/generate_secrets.py
# ===================================================================

# Optional: Redis for rate limiting (recommended for production)
# REDIS_URL=redis://redis:6379/0

# Optional: Sentry for error tracking
# SENTRY_DSN=your-sentry-dsn-here

# Optional: Email configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
