# ===================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================
# IMPORTANT: Do NOT use default values in production!
# Generate secure values using: python scripts/generate_secrets.py
# ===================================================================

# Database
# For Development: Use SQLite
DATABASE_URL=sqlite:///./erp.db
# For Production: Use PostgreSQL (REQUIRED)
# DATABASE_URL=postgresql://username:secure_password@hostname:5432/database_name

# Security (CRITICAL - MUST CHANGE FOR PRODUCTION)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-TO-SECURE-RANDOM-STRING-MIN-32-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Features
ENABLE_AUTH=true
ENABLE_TENANCY=false
ENABLE_SUBSCRIPTIONS=false

# CORS (CRITICAL - Update for production domain)
# Format MUST be valid JSON array
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production example:
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Admin User (CRITICAL - MUST CHANGE FOR PRODUCTION)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-THIS-SECURE-PASSWORD-MIN-16-CHARS

# Application
PROJECT_NAME=Multi-Tenant ERP
VERSION=0.1.0
ENVIRONMENT=development
# For production: ENVIRONMENT=production
